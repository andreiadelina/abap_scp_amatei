@Metadata.layer: #CORE
@UI.headerInfo: 
 {
    typeName: 'Libro',
    typeNamePlural: 'Libros',
    typeImageUrl: '',
    imageUrl: 'Imagen',
    title: {
        type: #STANDARD,
        label: '',
        iconUrl: '',
        criticality: '',
        criticalityRepresentation: #WITHOUT_ICON,
        value: 'Id_Libro',
        valueQualifier: '',
        targetElement: '',
        url: ''
        },
    description: {
        type: #STANDARD,
        label: '',
        iconUrl: '',
        criticality: '',
        criticalityRepresentation: #WITHOUT_ICON,
        value: 'Categoria',
        valueQualifier: '',
        targetElement: '',
        url: '' }
}

@Search.searchable: true
annotate view Z_I_BIBLIOTECA_VIRTUAL 
    with 
{   @UI.facet: [ { id: 'DetallesLibro', label: 'Detalles del Libro' , type: #COLLECTION, position: 10 }, 
                 { id: 'Libro', parentId: 'DetallesLibro', label: 'Detalles', type: #FIELDGROUP_REFERENCE, 
                   targetQualifier: 'DetallesLibro', position : 10 },
                  { id: 'Cliente', label: 'Clientes', type: #LINEITEM_REFERENCE, targetElement: '_ClientesLibros', position: 20 } ]
                 
    @UI.fieldGroup: [{ qualifier: 'DetallesLibro', position: 10 }]
    Id_Libro;
    
    @UI: { lineItem: [{ position: 10, importance: #HIGH }],
           selectionField: [{ position: 10 }] }
    Titulo;
    
    @UI.lineItem: [{ position: 20, importance: #HIGH }]
    Autor;
     
    @UI.lineItem: [{ position: 30, importance: #MEDIUM }]
    @Consumption.valueHelpDefinition: [{ entity: { name: 'z_b_catego_ma', element: 'Categoria' } }]
    Categoria;
   
    @UI.lineItem: [{ position: 40, importance: #MEDIUM }]
    Precio;
    
    @UI.lineItem: [{ position: 50, importance: #HIGH, label: 'Estado', criticality: 'Ventas'}]
    Estado;
    
    @UI.lineItem: [{ position: 60, importance: #LOW }]
    @Search: {
        defaultSearchElement: true,
        ranking: #MEDIUM,
        fuzzinessThreshold: 0.8 
  
    }
    Editorial;
    
    @UI.fieldGroup: [{ qualifier: 'DetallesLibro', position: 20 }]
    Formato;
    
    @UI.fieldGroup: [{ qualifier: 'DetallesLibro', position: 30 }]
    Paginas;
    
    @UI.fieldGroup: [{ qualifier: 'DetallesLibro', position: 40 }]
    Idioma;
    
    @UI.fieldGroup: [{ qualifier: 'DetallesLibro', position: 50 }]
    Imagen;

}